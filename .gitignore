*.env
.env
.env.*
server.cfg

# Editor and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Build or packaging output
dist/
*.zip
*.7z

# Test harness bytecode
__pycache__/
*.pyc

